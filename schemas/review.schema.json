{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story Review Schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the story"
    },
    "age_group_suitable": {
      "type": "boolean",
      "description": "Is the story suitable for its target age group?"
    },
    "age_group_notes": {
      "type": "string",
      "description": "Brief explanation for the age rating"
    },
    "coherent_story": {
      "type": "boolean",
      "description": "Does the story make sense as a children's story?"
    },
    "coherent_notes": {
      "type": "string",
      "description": "Brief explanation for the coherence rating"
    },
    "engagement_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "How engaging is the story? 1=dull, 10=captivating"
    },
    "engagement_notes": {
      "type": "string",
      "description": "Brief explanation for the engagement score"
    },
    "issues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific problems found"
    },
    "suggestions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Actionable improvements"
    },
    "verdict": {
      "type": "string",
      "description": "One-sentence summary"
    },
    "approved": {
      "type": "boolean",
      "description": "Ready for book creation?"
    }
  },
  "required": [
    "title",
    "age_group_suitable",
    "age_group_notes",
    "coherent_story",
    "coherent_notes",
    "engagement_score",
    "engagement_notes",
    "issues",
    "suggestions",
    "verdict",
    "approved"
  ]
}
